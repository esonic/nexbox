# boxnex-agent — lightweight per-project isolation container
#
# Build:  podman build -f Dockerfile.agent -t boxnex-agent:latest .
# Or use: scripts/build-agent-image.sh
#
# This image is NOT the server image. It is the sandbox container that
# runs one instance per project when PodmanEnabled=true in config.json.
# The project's git repository is bind-mounted to /workspace at runtime.

FROM alpine:latest

# Runtime dependencies required by the Claude CLI (glibc-compat via libgcc/libstdc++)
# and ripgrep for fast file search inside the agent sandbox.
RUN apk add --no-cache \
    libgcc \
    libstdc++ \
    ripgrep \
    curl \
    git \
    bash \
    shadow

# Install the official Claude CLI, move the binary to /usr/local/bin/claude (world-
# traversable directory), then delete /root/.local to avoid keeping a ~200MB duplicate.
# All in one RUN so the install artifacts don't survive as a separate layer.
#
# Security: binary is chown'd to claude-runner (9999) with chmod 0500 so only
# UID 9999 can execute it. agent (1000) gets Permission denied.
RUN curl -fsSL https://claude.ai/install.sh | bash && \
    CLAUDE_BIN=$(realpath /root/.local/bin/claude) && \
    /root/.local/bin/claude --version && \
    mv "$CLAUDE_BIN" /usr/local/bin/claude && \
    rm -rf /root/.local && \
    addgroup -g 1001 workspace-users && \
    adduser -D -u 1000 -G workspace-users agent && \
    adduser -D -u 9999 -G workspace-users claude-runner && \
    chown 9999:9999 /usr/local/bin/claude && \
    chmod 0500 /usr/local/bin/claude

# Default working directory — overridden at runtime via -w /workspace bind-mount
WORKDIR /workspace

# The container is kept alive by the ContainerManager using:
#   podman run -d --rm -v <repoPath>:/workspace -w /workspace boxnex-agent:latest tail -f /dev/null
# No ENTRYPOINT or CMD is needed here; the manager passes the command explicitly.
